{
 "name": "Opal",
 "scopeName": "source.opal",
 "patterns": [
  {
   "begin": "-- ",
   "end": "$",
   "name": "def.comment",
   "patterns": [
    {
     "patterns": [
      {
       "begin": "\\\\$",
       "end": "^",
       "name": "def.preprocessor"
      },
      {
       "patterns": [
        {
         "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
         "name": "def.underlined"
        },
        {
         "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
         "name": "def.underlined"
        },
        {
         "match": "\\b(FIXME|TODO|XXX)\\b",
         "name": "def.note"
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "match": "(?<![[A-Za-z0-9_\\x80-\\xFF]\\.])([1-9][0-9]*|0)[lL]?(?![[A-Za-z0-9_\\x80-\\xFF]\\.])",
   "name": "def.decimal"
  },
  {
   "begin": "/\\*",
   "end": "\\*/",
   "name": "def.comment",
   "patterns": [
    {
     "patterns": [
      {
       "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
       "name": "def.underlined"
      },
      {
       "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
       "name": "def.underlined"
      },
      {
       "match": "\\b(FIXME|TODO|XXX)\\b",
       "name": "def.note"
      }
     ]
    }
   ]
  },
  {
   "match": "\\*/(?!\\*)",
   "name": "def.error"
  },
  {
   "begin": "\"",
   "end": "(?:\")|$",
   "name": "def.string"
  },
  {
   "match": "\\b(?:IMPORT|COMPLETELY|ONLY)\\b",
   "name": "def.preprocessor"
  },
  {
   "match": "\\b(?:ALL|AND|ANDIF|ANY|AS|ASSERT|AXM|DATA|DEF|DERIVE|DFD|DESCRIMINATORS|ELSE|EX|EXTERNAL|FI|FIX|FUN|IF|IMPLEMENTATION|IMPLIES|IN|INHERIT|INJECTIONS|INTERFACE|INTERNAL|LAW|LAZY|LEFTASSOC|LET|MODULE|NOT|NOR|OR|ORIF|OTHERWISE|POST|PRE|PRED|PRIORITY|PROPERTIES|REALIZES|REQUIRE|RIGHTASSOC|SELECTORS|SIGNATURE|SORT|SPC|SPEC|SPECIFICATION|STRUCTURE|THE|THEN|THEORY|THM|TYPE|UNIQ|WHERE)\\b",
   "name": "def.keyword"
  },
  {
   "match": "\\b(?:::|==|\\->)\\b",
   "name": "def.keyword"
  },
  {
   "match": "\\b(?:aEntry|agent|align|anchor|ans|arg|arg1|arg2|array|arrowWhere|bag|bitmap|bool|bstree|byte|callback|canvasEditor|capStyle|channel|char|childstat|codom|codomFrom|codomTo|color|colorModel|com|composeOp|config|configCom|cursor|dArray|data|data1|data11|data2|data21|data3|data31|data4|data41|dataFrom|dataTo|defaultPrio|denotation|device|dist|distOut|dom|domFrom|domTo|drawing|dyn|emitter|env|event|eventInfo|file|filemode|filestat|filetype|first|first1|first2|first3|fission|fmt|font|from|from1|from2|funct|group|groupid|heap|iconfig|image|in|inData|index|inode|input|int|inter|interdom|interpreter|iseq|items|joinStyle|justifyHow|long|manager|managerRequest|map|mapEntry|mark|mid|modifier|nat|natMap|OBJECT|option|orient|out|outData|output|packOp|pair|parser|permission|point|positionRequest|process|procstat|quad|range|real|regulator|rel|relief|res|res1|res2|result|role|sap|script|scroller|scrollView|scrollWindow|searchOpt|second|seekMode|selector|semaphor|seq|seqEntry|set|setEntry|short|sigaction|sighandler|sigmask|signal|size|sizeRequest|some|sreal|state|stateId|stateRequest|string|subrel|tag|textEditor|time|to|tree|triple|union|user|userid|version|view|void|wconfig|wconfigCom|wday|widget|window|wrapStyle)\\b",
   "name": "def.type"
  },
  {
   "match": "\\b(?:true|false)\\b",
   "name": "def.boolean"
  }
 ],
 "fileTypes": [
  "sign",
  "impl"
 ]
}