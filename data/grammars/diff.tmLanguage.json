{
 "name": "Diff",
 "scopeName": "source.diff",
 "patterns": [
  {
   "begin": "(?:^(diff |\\+\\+\\+ |Index: |==== |\\*\\*\\* |--- ))",
   "end": "$",
   "name": "diff.diff-file"
  },
  {
   "match": "^(<|-).*$",
   "name": "diff.removed-line"
  },
  {
   "match": "^(\\+|>).*$",
   "name": "diff.added-line"
  },
  {
   "match": "^\\! .*$",
   "name": "diff.changed-line"
  },
  {
   "begin": "^((@@)|[0-9]|\\*\\*\\*\\*)",
   "end": "$",
   "name": "diff.location",
   "patterns": [
    {
     "match": "\\\\.",
     "name": "def.special-char"
    }
   ]
  },
  {
   "match": "^(?:Only\\ in\\ \\.\\*|Files\\ \\.\\*\\ and\\ \\.\\*\\ are\\ identical\\$|Files\\ \\.\\*\\ and\\ \\.\\*\\ differ\\$|Binary\\ files\\ \\.\\*\\ and\\ \\.\\*\\ differ\\$|File\\ \\.\\*\\ is\\ a\\ \\.\\*\\ while\\ file\\ \\.\\*\\ is\\ a\\ \\.\\*|No\\ newline\\ at\\ end\\ of\\ file\\ \\.\\*)\\b",
   "name": "diff.special-case"
  },
  {
   "begin": "^\\S",
   "end": "$",
   "name": "def.comment"
  }
 ],
 "fileTypes": [
  "diff",
  "patch",
  "rej"
 ]
}