{
 "name": "pkg-config",
 "scopeName": "source.pkgconfig",
 "patterns": [
  {
   "begin": "#",
   "end": "$",
   "name": "def.comment",
   "patterns": [
    {
     "patterns": [
      {
       "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
       "name": "def.underlined"
      },
      {
       "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
       "name": "def.underlined"
      },
      {
       "match": "\\b(FIXME|TODO|XXX)\\b",
       "name": "def.note"
      }
     ]
    }
   ]
  },
  {
   "begin": "^([[A-Za-z0-9_\\x80-\\xFF]_]+)\\s*=\\s*",
   "end": "$",
   "beginCaptures": {
    "1": {
     "name": "def.keyword"
    }
   },
   "patterns": [
    {
     "match": "\\$\\{[[A-Za-z0-9_\\x80-\\xFF]_]*\\}",
     "name": "def.keyword"
    }
   ]
  },
  {
   "begin": "^([[A-Za-z0-9_\\x80-\\xFF]_\\.]+)\\s*\\:\\s*",
   "end": "$",
   "beginCaptures": {
    "1": {
     "name": "def.keyword"
    }
   },
   "patterns": [
    {
     "match": "\\$\\{[[A-Za-z0-9_\\x80-\\xFF]_]*\\}",
     "name": "def.keyword"
    }
   ]
  }
 ],
 "fileTypes": [
  "pc"
 ]
}