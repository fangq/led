{
 "name": "ActionScript",
 "scopeName": "source.actionscript",
 "patterns": [
  {
   "begin": "\"",
   "end": "(?:\")|$",
   "name": "def.string"
  },
  {
   "begin": "'",
   "end": "(?:')|$",
   "name": "def.string"
  },
  {
   "begin": "//",
   "end": "$",
   "name": "def.comment",
   "patterns": [
    {
     "patterns": [
      {
       "begin": "\\\\$",
       "end": "^",
       "name": "def.preprocessor"
      },
      {
       "patterns": [
        {
         "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
         "name": "def.underlined"
        },
        {
         "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
         "name": "def.underlined"
        },
        {
         "match": "\\b(FIXME|TODO|XXX)\\b",
         "name": "def.note"
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "begin": "/\\*",
   "end": "\\*/",
   "name": "def.comment",
   "patterns": [
    {
     "patterns": [
      {
       "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
       "name": "def.underlined"
      },
      {
       "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
       "name": "def.underlined"
      },
      {
       "match": "\\b(FIXME|TODO|XXX)\\b",
       "name": "def.note"
      }
     ]
    }
   ]
  },
  {
   "match": "\\*/(?!\\*)",
   "name": "def.error"
  },
  {
   "match": "\\b(?:import|include|package)\\b",
   "name": "def.preprocessor"
  },
  {
   "match": "\\b(?:class|extends|function|implements|instanceof|interface|is|namespace|throws|var|const)\\b",
   "name": "def.type"
  },
  {
   "match": "\\b(?:arguments|Array|Boolean|Class|Bitmap|BitmapData|BitmapDataChannel|ByteArray|Camera|Capabilities|CapsStyle|ColorTransform|ContextMenu|Dictionary|DisplayObject|DisplayObjectContainer|Endian|Error|Event|EventDispatcher|ExternalInterface|FileFilter|FileReference|FileReferenceList|Function|Graphics|int|IBitmapDrawable|IEventDispatcher|IOError|Keyboard|KeyboardEvent|KeyLocation|Loader|LocalConnection|Math|Matrix|Microphone|Mouse|MovieClip|Namespace|NetConnection|NetStream|Number|Object|Point|PrintJob|Proxy|QName|Rectangle|RegExp|Responder|Scene|Security|Shape|SharedObject|Socket|Sound|SoundChannel|SoundTransform|Sprite|Stage|String|StyleSheet|SWFVersion|System|TextField|TextFormat|Timer|uint|Video|XML|XMLDocument|XMLList|XMLNode|XMLNodeType|XMLSocket)\\b",
   "name": "def.type"
  },
  {
   "match": "\\b(?:dynamic|internal|final|static)\\b",
   "name": "def.type"
  },
  {
   "match": "\\b(?:flash_proxy|internal|override|private|protected|public|set|get)\\b",
   "name": "def.type"
  },
  {
   "match": "\\b(?:break|case|catch|continue|default|do|else|for|if|is|return|throw|switch|try|while)\\b",
   "name": "def.keyword"
  },
  {
   "match": "\\b(?:new|super|this|void)\\b",
   "name": "def.keyword"
  },
  {
   "match": "\\b(?:goto)\\b",
   "name": "def.error"
  },
  {
   "match": "\\b(?:null)\\b",
   "name": "def.special-constant"
  },
  {
   "match": "\\b(?:false|true)\\b",
   "name": "def.boolean"
  },
  {
   "match": "(\\b([0-9]+|0[xX][0-9a-fA-F]+)[Ll]?\\b|\\b(([0-9]+[Ee][-]?[0-9]+|([0-9]*\\.[0-9]+|[0-9]+\\.)([Ee][-]?[0-9]+)?)[fFdD]?|[0-9]+[FfDd]))",
   "name": "def.decimal"
  }
 ],
 "fileTypes": [
  "as"
 ]
}