{
 "name": "Erlang",
 "scopeName": "source.erlang",
 "patterns": [
  {
   "begin": "%",
   "end": "$",
   "name": "def.comment",
   "patterns": [
    {
     "patterns": [
      {
       "begin": "\\\\$",
       "end": "^",
       "name": "def.preprocessor"
      },
      {
       "patterns": [
        {
         "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
         "name": "def.underlined"
        },
        {
         "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
         "name": "def.underlined"
        },
        {
         "match": "\\b(FIXME|TODO|XXX)\\b",
         "name": "def.note"
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "match": "\\b(?:after|begin|case|catch|cond|end|fun|if|let|of|query|receive|when)\\b",
   "name": "def.keyword"
  },
  {
   "match": "\\b(?:and|band|bnot|bor|bsl|bsr|bxor|div|not|or|rem|xor)\\b",
   "name": "def.operator"
  },
  {
   "begin": "'",
   "end": "'",
   "name": "def.type",
   "patterns": [
    {
     "match": "\\\\.",
     "name": "def.special-char"
    }
   ]
  },
  {
   "begin": "\"",
   "end": "\"",
   "name": "def.string",
   "patterns": [
    {
     "match": "\\\\.",
     "name": "def.special-char"
    }
   ]
  },
  {
   "match": "\\$(?:(\\\\.)|.)",
   "name": "def.character",
   "captures": {
    "1": {
     "name": "def.special-char"
    }
   }
  },
  {
   "match": "(?<![[A-Za-z0-9_\\x80-\\xFF]\\.])[0-9]+\\.[0-9]+([Ee][+-]?[0-9]+)?(?![[A-Za-z0-9_\\x80-\\xFF]\\.])",
   "name": "def.floating-point"
  },
  {
   "match": "(?<![[A-Za-z0-9_\\x80-\\xFF]\\.])[1-9]([0-9])?(?![[A-Za-z0-9_\\x80-\\xFF]\\.])",
   "name": "def.base-n-integer"
  },
  {
   "match": "(?<![[A-Za-z0-9_\\x80-\\xFF]\\.])[0-9]+(?![[A-Za-z0-9_\\x80-\\xFF]\\.])",
   "name": "def.decimal"
  },
  {
   "match": "\\b(?:abs|alive|apply|atom_to_list|atom|binary_to_list|binary_to_ter|binary|check_process_code|concat_binary|constant|date|delete_module|disconnect_node|element|erase|exit|float|float_to_list|function|get_cookie|get_keys|get|group_leader|halt|hash|hd|integer_to_list|integer|is_alive|length|link|list_to_atom|list_to_binary|list_to_float|list_to_integer|list_to_pid|list_to_tuple|list|load_module|make_ref|math|module_loaded|monitor_node|node|nodes|now|number|open_port|pid_to_list|pid|ports|port_close|port_info|preloaded|processes|process_flag|process_info|process|purge_module|put|record|reference|registered|register|round|self|setelement|set_cookie|set_node|size|spawn_link|spawn|split_binary|statistics|term_to_binary|throw|time|tl|trunc|tuple_to_list|unlink|unregister|whereis)\\b",
   "name": "def.builtin"
  },
  {
   "match": "-(?:author|compile|copyright|define|doc|else|endif|export|file|ifdef|ifndef|import|include_lib|include|module|record|undef)\\b",
   "name": "def.preprocessor"
  }
 ],
 "fileTypes": [
  "erl",
  "hrl"
 ]
}