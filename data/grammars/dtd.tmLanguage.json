{
 "name": "DTD",
 "scopeName": "source.dtd",
 "patterns": [
  {
   "begin": "<!--",
   "end": "-->",
   "name": "def.comment",
   "patterns": [
    {
     "match": "--+",
     "name": "def.error"
    },
    {
     "patterns": [
      {
       "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
       "name": "def.underlined"
      },
      {
       "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
       "name": "def.underlined"
      },
      {
       "match": "\\b(FIXME|TODO|XXX)\\b",
       "name": "def.note"
      }
     ]
    }
   ]
  },
  {
   "begin": "<!ELEMENT\\b",
   "end": ">",
   "beginCaptures": {
    "0": {
     "name": "xml.doctype"
    }
   },
   "endCaptures": {
    "0": {
     "name": "xml.doctype"
    }
   },
   "patterns": [
    {
     "match": "%(?:[a-zA-Z_][a-zA-Z0-9.:_-]*);",
     "name": "xml.entity"
    },
    {
     "begin": "\"",
     "end": "\"",
     "name": "xml.attribute-value",
     "patterns": [
      {
       "match": "[%&](?:[a-zA-Z_][a-zA-Z0-9.:_-]*);",
       "name": "xml.entity"
      },
      {
       "match": "[%&]\\S*",
       "name": "xml.error"
      }
     ]
    }
   ]
  },
  {
   "begin": "<!ENTITY\\s+(%\\s+)?(?:[a-zA-Z_][a-zA-Z0-9.:_-]*)\\b",
   "end": ">",
   "beginCaptures": {
    "0": {
     "name": "xml.doctype"
    }
   },
   "endCaptures": {
    "0": {
     "name": "xml.doctype"
    }
   },
   "patterns": [
    {
     "begin": "\"",
     "end": "\"",
     "name": "xml.attribute-value",
     "patterns": [
      {
       "match": "[%&](?:[a-zA-Z_][a-zA-Z0-9.:_-]*);",
       "name": "xml.entity"
      },
      {
       "match": "[%&]\\S*",
       "name": "xml.error"
      }
     ]
    },
    {
     "begin": "(SYSTEM|PUBLIC)(?=\\s|$)",
     "end": "$",
     "beginCaptures": {
      "0": {
       "name": "xml.doctype"
      }
     },
     "patterns": [
      {
       "begin": "\"",
       "end": "\"",
       "name": "xml.attribute-value",
       "patterns": [
        {
         "match": "[%&](?:[a-zA-Z_][a-zA-Z0-9.:_-]*);",
         "name": "xml.entity"
        },
        {
         "match": "[%&]\\S*",
         "name": "xml.error"
        }
       ]
      },
      {
       "begin": "\\bNDATA\\b",
       "end": "$",
       "beginCaptures": {
        "0": {
         "name": "xml.doctype"
        }
       },
       "patterns": [
        {
         "match": "(?:[a-zA-Z_][a-zA-Z0-9.:_-]*)"
        },
        {
         "match": "\\S+",
         "name": "xml.error"
        }
       ]
      },
      {
       "match": "\\S+",
       "name": "xml.error"
      }
     ]
    },
    {
     "match": "\\S+",
     "name": "xml.error"
    }
   ]
  },
  {
   "begin": "<!ATTLIST\\b",
   "end": ">",
   "beginCaptures": {
    "0": {
     "name": "xml.doctype"
    }
   },
   "endCaptures": {
    "0": {
     "name": "xml.doctype"
    }
   },
   "patterns": [
    {
     "match": "%(?:[a-zA-Z_][a-zA-Z0-9.:_-]*);",
     "name": "xml.entity"
    },
    {
     "begin": "\"",
     "end": "\"",
     "name": "xml.attribute-value",
     "patterns": [
      {
       "match": "[%&](?:[a-zA-Z_][a-zA-Z0-9.:_-]*);",
       "name": "xml.entity"
      },
      {
       "match": "[%&]\\S*",
       "name": "xml.error"
      }
     ]
    }
   ]
  },
  {
   "begin": "<!NOTATION\\b",
   "end": ">",
   "beginCaptures": {
    "0": {
     "name": "xml.doctype"
    }
   },
   "endCaptures": {
    "0": {
     "name": "xml.doctype"
    }
   },
   "patterns": [
    {
     "match": "%(?:[a-zA-Z_][a-zA-Z0-9.:_-]*);",
     "name": "xml.entity"
    },
    {
     "begin": "\"",
     "end": "\"",
     "name": "xml.attribute-value",
     "patterns": [
      {
       "match": "[%&](?:[a-zA-Z_][a-zA-Z0-9.:_-]*);",
       "name": "xml.entity"
      },
      {
       "match": "[%&]\\S*",
       "name": "xml.error"
      }
     ]
    }
   ]
  }
 ],
 "fileTypes": [
  "dtd"
 ]
}