{
 "name": "Protobuf",
 "scopeName": "source.proto",
 "patterns": [
  {
   "begin": "//",
   "end": "$",
   "name": "def.comment",
   "patterns": [
    {
     "patterns": [
      {
       "begin": "\\\\$",
       "end": "^",
       "name": "def.preprocessor"
      },
      {
       "patterns": [
        {
         "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
         "name": "def.underlined"
        },
        {
         "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
         "name": "def.underlined"
        },
        {
         "match": "\\b(FIXME|TODO|XXX)\\b",
         "name": "def.note"
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "begin": "/\\*",
   "end": "\\*/",
   "name": "def.comment",
   "patterns": [
    {
     "patterns": [
      {
       "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
       "name": "def.underlined"
      },
      {
       "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
       "name": "def.underlined"
      },
      {
       "match": "\\b(FIXME|TODO|XXX)\\b",
       "name": "def.note"
      }
     ]
    }
   ]
  },
  {
   "match": "(syntax)\\s+=\\s+(\"proto2\"|\"proto3\");",
   "captures": {
    "1": {
     "name": "def.preprocessor"
    },
    "2": {
     "name": "def.string"
    }
   }
  },
  {
   "match": "(package)\\s+(.*);",
   "captures": {
    "1": {
     "name": "def.preprocessor"
    },
    "2": {
     "name": "def.string"
    }
   }
  },
  {
   "match": "(import)(\\s+(weak|public))?\\s+(\".*\");",
   "captures": {
    "1": {
     "name": "def.preprocessor"
    },
    "2": {
     "name": "def.preprocessor"
    },
    "4": {
     "name": "def.string"
    }
   }
  },
  {
   "match": "[$@%][$]?[a-zA-Z_][a-zA-Z0-9_]*",
   "name": "def.type"
  },
  {
   "begin": "\"",
   "end": "(?:\")|$",
   "name": "def.string"
  },
  {
   "match": "\\b(?:default|deprecated|enum|extend|extensions|message|oneof|optional|option|package|packed|repeated|required|returns|rpc|service|to)\\b",
   "name": "def.keyword"
  },
  {
   "match": "\\b(?:double|float|int32|int64|uint32|uint64|sint32|sint64|fixed32|fixed64|sfixed32|sfixed64|bool|string|bytes)\\b",
   "name": "def.type"
  },
  {
   "match": "\\b(?:true|false)\\b",
   "name": "def.boolean"
  }
 ],
 "fileTypes": [
  "proto"
 ]
}