{
 "name": "CG Shader Language",
 "scopeName": "source.cg",
 "patterns": [
  {
   "begin": "//",
   "end": "$",
   "beginCaptures": {
    "0": {
     "name": "def.comment"
    }
   },
   "endCaptures": {
    "0": {
     "name": "def.comment"
    }
   },
   "patterns": [
    {
     "patterns": [
      {
       "begin": "\\\\$",
       "end": "^",
       "beginCaptures": {
        "0": {
         "name": "def.preprocessor"
        }
       },
       "endCaptures": {
        "0": {
         "name": "def.preprocessor"
        }
       }
      },
      {
       "patterns": [
        {
         "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
         "name": "def.underlined"
        },
        {
         "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
         "name": "def.underlined"
        },
        {
         "match": "\\b(FIXME|TODO|XXX)\\b",
         "name": "def.note"
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "begin": "/\\*",
   "end": "\\*/",
   "beginCaptures": {
    "0": {
     "name": "def.comment"
    }
   },
   "endCaptures": {
    "0": {
     "name": "def.comment"
    }
   },
   "patterns": [
    {
     "patterns": [
      {
       "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
       "name": "def.underlined"
      },
      {
       "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
       "name": "def.underlined"
      },
      {
       "match": "\\b(FIXME|TODO|XXX)\\b",
       "name": "def.note"
      }
     ]
    }
   ]
  },
  {
   "match": "\\*/(?!\\*)",
   "name": "def.error"
  },
  {
   "match": "(?:^\\s*#\\s*)(include|import)\\s*(\".*?\"|<.*>)",
   "name": "def.preprocessor",
   "captures": {
    "2": {
     "name": "def.string"
    }
   }
  },
  {
   "match": "(?<![[A-Za-z0-9_\\x80-\\xFF]\\.])((\\.[0-9]+|[0-9]+\\.[0-9]*)([Ee][+-]?[0-9]*)?|([0-9]+[Ee][+-]?[0-9]*))[fFlL]?(?![[A-Za-z0-9_\\x80-\\xFF]\\.])",
   "name": "def.floating-point"
  },
  {
   "match": "(?<![[A-Za-z0-9_\\x80-\\xFF]\\.])0[xX][a-fA-F0-9]+[uUlL]*(?![[A-Za-z0-9_\\x80-\\xFF]\\.])",
   "name": "def.base-n-integer"
  },
  {
   "match": "(?<![[A-Za-z0-9_\\x80-\\xFF]\\.])0[0-7]+[uUlL]*(?![[A-Za-z0-9_\\x80-\\xFF]\\.])",
   "name": "def.base-n-integer"
  },
  {
   "match": "(?<![[A-Za-z0-9_\\x80-\\xFF]\\.])[0-9]+[uUlL]*(?![[A-Za-z0-9_\\x80-\\xFF]\\.])",
   "name": "def.decimal"
  },
  {
   "match": "\\b(?:break|case|continue|default|else|for|if|return|struct|switch|while)\\b",
   "name": "def.keyword"
  },
  {
   "match": "\\b(?:bool|float|float2|float3|float4|float2x2|float3x3|float4x4|int|half|fixed|void|sampler1D|sampler2D|sampler3D|samplerRECT|samplerCUBE)\\b",
   "name": "def.type"
  },
  {
   "match": "\\b(?:uniform|out|inout|in|varying)\\b",
   "name": "def.builtin"
  },
  {
   "match": "\\b(?:POSITION|NORMAL)\\b",
   "name": "def.special-constant"
  },
  {
   "match": "COLOR[0-3]?",
   "name": "def.special-constant"
  },
  {
   "match": "TEXUNIT([0-9]|1[0-5])?",
   "name": "def.special-constant"
  },
  {
   "match": "TEXCOORD[0-7]?",
   "name": "def.special-constant"
  },
  {
   "match": "\\.([xyzw]+|[rgba]+)",
   "captures": {
    "1": {
     "name": "def.operator"
    }
   }
  },
  {
   "match": "\\b(?:true|false)\\b",
   "name": "def.boolean"
  },
  {
   "match": "(mul|lit|lerp|saturate|abs|cos|acos|sin|asin|tan|atan|all|any|ceil|clamp|cosh|cross|degress|determinant|dot|exp|exp2|floor|fmod|frac|frexp|isfinite|isinf|isnan|ldexp|log|log2|log10|max|min|modf|noise|pow|radians|round|rsqrt|sign|sincos|sinh|smoothstep|step|sqrt|tanh|transpose|distance|faceforward|length|normalize|reflect|refract|tex1D|tex2D|tex3D|tex1Dproj|tex2Dproj|tex3Dproj|texRECT|texRECTproj|texCUBE|texCUBEproj|ddx|ddy|debug)\\s*\\(",
   "captures": {
    "1": {
     "name": "def.preprocessor"
    }
   }
  },
  {
   "match": "([a-zA-Z_][a-zA-Z_0-9]*)\\s*\\(",
   "captures": {
    "1": {
     "name": "def.function"
    }
   }
  }
 ],
 "fileTypes": [
  "cg"
 ]
}