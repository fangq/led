  {
   "match": "\\b(?:end\\-call|call|cancel|goback|end\\-perform|perform|invoke|end\\-if|if)\\b",
   "name": "def.statement"
  },
  {
   "match": "\\b(?:identification|environment|data|procedure)\\b",
   "name": "def.keyword"
  },
  {
   "match": "\\b(?:configuration|input\\-output|file|working\\-storage|local\\-storage|linkage)\\b",
   "name": "def.keyword"
  },
  {
   "begin": "^\\s{0,6}\\*",
   "end": "$",
   "beginCaptures": {
    "0": {
     "name": "def.comment"
    }
   },
   "endCaptures": {
    "0": {
     "name": "def.comment"
    }
   },
   "patterns": [
    {
     "patterns": [
      {
       "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
       "name": "def.underlined"
      },
      {
       "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
       "name": "def.underlined"
      },
      {
       "match": "\\b(FIXME|TODO|XXX)\\b",
       "name": "def.note"
      }
     ]
    }
   ]
  },
  {
   "begin": "^\\s{0,6}[A-Za-z0-9_\\x80-\\xFF]",
   "end": "$",
   "beginCaptures": {
    "0": {
     "name": "def.error"
    }
   },
   "endCaptures": {
    "0": {
     "name": "def.error"
    }
   }
  },
  {
   "begin": "(\\*)(?=(?:[^\"']|[\"|'][^\"']*\")*$)",
   "end": "$",
   "beginCaptures": {
    "0": {
     "name": "def.error"
    }
   },
   "endCaptures": {
    "0": {
     "name": "def.error"
    }
   }
  },
  {
   "match": ".{74,}",
   "name": "def.error"
  },
  {
   "begin": "\"",
   "end": "(?:\")|$",
   "beginCaptures": {
    "0": {
     "name": "def.string"
    }
   },
   "endCaptures": {
    "0": {
     "name": "def.string"
    }
   }
  },
  {
   "begin": "'",
   "end": "(?:')|$",
   "beginCaptures": {
    "0": {
     "name": "def.string"
    }
   },
   "endCaptures": {
    "0": {
     "name": "def.string"
    }
   }
  },
  {
   "match": "\\b[0-9]+(\\.[0-9]+)?\\b",
   "name": "def.decimal"
  },
  {
   "match": "\\b([A-Za-z0-9_]*)\\b",
   "name": "def.type"
  }
 ],
 "fileTypes": [
  "cbl",
  "cob",
  "cbd",
  "cdb",
  "cdc"
 ]
}