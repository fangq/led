{
 "name": "Automake",
 "scopeName": "source.automake",
 "patterns": [
  {
   "match": "\\b(?:define|else|endef|endif|if|ifdef|ifeq|ifndef|ifneq|include|override|unexport)\\b",
   "name": "def.keyword"
  },
  {
   "match": "\\b(?:addprefix|addsuffix|basename|call|dir|error|filter|filter\\-out|findstring|firstword|foreach|join|notdir|origin|patsubst|shell|sort|strip|subst|suffix|warning|wildcard|word|words)\\b",
   "name": "def.function"
  },
  {
   "match": "@(?:[A-Za-z0-9_@]+)@",
   "name": "def.preprocessor"
  },
  {
   "begin": "^##",
   "end": "$",
   "patterns": [
    {
     "patterns": [
      {
       "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
       "name": "def.underlined"
      },
      {
       "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
       "name": "def.underlined"
      },
      {
       "match": "\\b(FIXME|TODO|XXX)\\b",
       "name": "def.note"
      }
     ]
    }
   ]
  },
  {
   "begin": "#",
   "end": "$",
   "patterns": [
    {
     "match": "@(?:[A-Za-z0-9_@]+)@",
     "name": "def.preprocessor"
    },
    {
     "patterns": [
      {
       "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
       "name": "def.underlined"
      },
      {
       "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
       "name": "def.underlined"
      },
      {
       "match": "\\b(FIXME|TODO|XXX)\\b",
       "name": "def.note"
      }
     ]
    }
   ]
  },
  {
   "patterns": [
    {
     "begin": "(?:^ *)((?:AM_)?(?:C|CCAS|CPP|CXX|F|GCJ|JAVAC|L|LD|LIBTOOL|(?:[A-Z]+_)?LOG|MAKEINFO(?:HTML)?|OBJC|R|UPC|VALA|Y)FLAGS)(?:\\s*[\\+\\?:]?=)",
     "end": "$",
     "beginCaptures": {
      "1": {
       "name": "def.statement"
      }
     }
    },
    {
     "begin": "(?:^ *)((?:ACLOCAL_AMFLAGS|AM_DEFAULT_SOURCE_EXT|AUTOMAKE_OPTIONS|BUILT_SOURCES|CC|CLASSPATH_ENV|(?:DIST|MAINTAINER|MOSTLY)?CLEANFILES|COMPILE|(?:CXX|FC|OBJC|UPC)(?:COMPILE|LINK)?|DEFAULT_INCLUDES|DEFS|DISTCHECK_CONFIGURE_FLAGS|DVIPS|ETAGS_ARGS|EXTRA_DIST|F77(?:COMPILE)?|FLINK|INCLUDE|JAVAC|JAVAROOT|LIBS|LINK|(?:[A-Z]+_)?LOG_COMPILER|MAKEINFO(?:HTML)?|(?:OMIT|TAGS)_DEPENDENCIES|(?:DIST_)?SUBDIRS|SUFFIXES|(?:AM_)?TESTS_ENVIRONMENT|TESTS|TEXI2(?:DVI|PDF)|TEXINFO_TEX|VALAC))(?:\\s*[\\+\\?:]?=)",
     "end": "$",
     "beginCaptures": {
      "1": {
       "name": "def.statement"
      }
     }
    },
    {
     "begin": "(?:^ *)(?P<pprefix_1>(?:(?:(?:no)?dist|no(?:base|trans))_)*)(?:(?P<target_2>(?:noinst|check|EXTRA))|(?P<dirname_3>(?:s?bin|(?:pkg)?lib(?:exec)?|(?:pkg)?data|(?:pkg|old)?include|dataroot|sysconf|(?:shared|local)state|doc|info|html|dvi|pdf|ps|lisp|locale|man[1-8]?(?:ext)?|src|(?:pkg)?python|(?:pkg)?pyexec))|(?P<pvariable_4>(?:[A-Za-z0-9_@]+)))(?P<primary_5>_(?:PROGRAMS|(?:LT)?LIBRARIES|LISP|PYTHON|JAVA|SCRIPTS|DATA|HEADERS|MANS|TEXINFOS))(?:\\s*[\\+\\?:]?=)",
     "end": "$",
     "beginCaptures": {
      "primary": {
       "name": "def.type"
      },
      "pprefix": {
       "name": "def.statement"
      },
      "target": {
       "name": "def.statement"
      },
      "dirname": {
       "name": "def.statement"
      },
      "pvariable": {
       "name": "def.identifier"
      }
     }
    },
    {
     "begin": "(?:^ *)(?P<sprefix_6>(?:(?:(?:(?:no)?dist|no(?:base|trans))|EXTRA)_)*)(?P<svariable_7>(?:[A-Za-z0-9_@]+))(?P<secondary_8>_(?:AR|DEPENDENCIES|LDADD|LIBADD|LINK|SHORTNAME|SOURCES|(?:C|CCAS|CPP|CXX|F|GCJ|JAVAC|L|LD|LIBTOOL|(?:[A-Z]+_)?LOG|MAKEINFO(?:HTML)?|OBJC|R|UPC|VALA|Y)FLAGS))(?:\\s*[\\+\\?:]?=)",
     "end": "$",
     "beginCaptures": {
      "sprefix": {
       "name": "def.statement"
      },
      "svariable": {
       "name": "def.identifier"
      },
      "secondary": {
       "name": "def.statement"
      }
     }
    },
    {
     "begin": "(?:^ *)((?:[A-Za-z0-9_@]+))(dir)(?:\\s*[\\+\\?:]?=)",
     "end": "$",
     "beginCaptures": {
      "1": {
       "name": "def.identifier"
      },
      "2": {
       "name": "def.statement"
      }
     }
    },
    {
     "begin": "^((?:[a-zA-Z_][a-zA-Z0-9_]*))\\s*[\\+\\?:]?=",
     "end": "$",
     "beginCaptures": {
      "1": {
       "name": "makefile.assignment-lhs"
      }
     }
    }
   ]
  },
  {
   "begin": "^([^\\t\\:][^\\:]*)\\:",
   "end": "^(?!\\t)",
   "beginCaptures": {
    "1": {
     "name": "def.function"
    }
   },
   "patterns": [
    {
     "begin": "#",
     "end": "$",
     "beginCaptures": {
      "0": {
       "name": "def.comment"
      }
     },
     "endCaptures": {
      "0": {
       "name": "def.comment"
      }
     },
     "patterns": [
      {
       "patterns": [
        {
         "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
         "name": "def.underlined"
        },
        {
         "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
         "name": "def.underlined"
        },
        {
         "match": "\\b(FIXME|TODO|XXX)\\b",
         "name": "def.note"
        }
       ]
      }
     ]
    },
    {
     "match": "\\b(?:define|else|endef|endif|if|ifdef|ifeq|ifndef|ifneq|include|override|unexport)\\b",
     "name": "def.keyword"
    },
    {
     "begin": "(?<=:)(?=.)",
     "end": "(?:;)|$",
     "beginCaptures": {
      "0": {
       "name": "makefile.prereq"
      }
     },
     "endCaptures": {
      "0": {
       "name": "makefile.prereq"
      }
     },
     "patterns": [
      {
       "match": "\\\\.",
       "name": "def.special-char"
      },
      {
       "begin": "\\\\$",
       "end": "^",
       "beginCaptures": {
        "0": {
         "name": "def.preprocessor"
        }
       },
       "endCaptures": {
        "0": {
         "name": "def.preprocessor"
        }
       }
      },
      {
       "patterns": [
        {
         "match": "\\$\\(((?:[a-zA-Z_][a-zA-Z0-9_]*))\\)",
         "captures": {
          "1": {
           "name": "def.type"
          }
         }
        },
        {
         "match": "\\$\\{((?:[a-zA-Z_][a-zA-Z0-9_]*))\\}",
         "captures": {
          "1": {
           "name": "def.type"
          }
         }
        }
       ]
      },
      {
       "match": "\\b(?:addprefix|addsuffix|basename|call|dir|error|filter|filter\\-out|findstring|firstword|foreach|join|notdir|origin|patsubst|shell|sort|strip|subst|suffix|warning|wildcard|word|words)\\b",
       "name": "def.function"
      }
     ]
    },
    {
     "match": "^\\t+$",
     "name": "makefile.trailing-tab"
    }
   ]
  }
 ],
 "fileTypes": [
  "Makefile.am",
  "GNUmakefile.am"
 ]
}