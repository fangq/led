{
 "name": "CSV",
 "scopeName": "source.csv",
 "patterns": [
  {
   "match": "(?<![[A-Za-z0-9_\\x80-\\xFF]\\.])[0-9]+(?![[A-Za-z0-9_\\x80-\\xFF]\\.])",
   "name": "def.decimal"
  },
  {
   "match": "(?<![[A-Za-z0-9_\\x80-\\xFF]\\.])((\\.[0-9]+|[0-9]+\\.[0-9]*)([Ee][+-]?[0-9]*)?|([0-9]+[Ee][+-]?[0-9]*))(?![[A-Za-z0-9_\\x80-\\xFF]\\.])",
   "name": "def.floating-point"
  },
  {
   "begin": "\"",
   "end": "\"",
   "beginCaptures": {
    "0": {
     "name": "def.string"
    }
   },
   "endCaptures": {
    "0": {
     "name": "def.string"
    }
   },
   "patterns": [
    {
     "match": "\\\"\\\"",
     "name": "def.special-char"
    }
   ]
  }
 ],
 "fileTypes": [
  "csv"
 ]
}