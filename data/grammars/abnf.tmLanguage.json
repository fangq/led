{
 "name": "ABNF",
 "scopeName": "source.abnf",
 "patterns": [
  {
   "begin": ";",
   "end": "$",
   "beginCaptures": {
    "0": {
     "name": "def.comment"
    }
   },
   "endCaptures": {
    "0": {
     "name": "def.comment"
    }
   },
   "patterns": [
    {
     "patterns": [
      {
       "begin": "\\\\$",
       "end": "^",
       "beginCaptures": {
        "0": {
         "name": "def.preprocessor"
        }
       },
       "endCaptures": {
        "0": {
         "name": "def.preprocessor"
        }
       }
      },
      {
       "patterns": [
        {
         "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
         "name": "def.underlined"
        },
        {
         "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
         "name": "def.underlined"
        },
        {
         "match": "\\b(FIXME|TODO|XXX)\\b",
         "name": "def.note"
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "begin": "^\\s*((?:([a-zA-Z][a-zA-Z0-9-]*|<[a-zA-Z][a-zA-Z0-9-]*>)))\\s*=/?",
   "end": "^(?!\\s)",
   "beginCaptures": {
    "1": {
     "name": "def.type"
    }
   },
   "patterns": [
    {
     "patterns": [
      {
       "match": "((?:([a-zA-Z][a-zA-Z0-9-]*|<[a-zA-Z][a-zA-Z0-9-]*>)))",
       "captures": {
        "1": {
         "name": "def.type"
        }
       }
      },
      {
       "patterns": [
        {
         "match": "%b[0-1]+(\\-[0-1]+|(\\.[0-1]+)*)",
         "name": "def.base-n-integer"
        },
        {
         "match": "%d[0-9]+(\\-[0-9]+|(\\.[0-9]+)*)",
         "name": "def.decimal"
        },
        {
         "match": "%x[0-9a-fA-F]+(\\-[0-9a-fA-F]+|(\\.[0-9a-fA-F]+)*)",
         "name": "def.base-n-integer"
        },
        {
         "match": "\"[ !#$%&'\\(\\)\\*\\+,\\-\\./0-9:;<=>\\?@A-Z\\[\\\\\\]\\^_`a-z\\{\\|\\}~]*\"",
         "name": "def.string"
        }
       ]
      }
     ]
    },
    {
     "begin": ";",
     "end": "$",
     "beginCaptures": {
      "0": {
       "name": "def.comment"
      }
     },
     "endCaptures": {
      "0": {
       "name": "def.comment"
      }
     },
     "patterns": [
      {
       "patterns": [
        {
         "begin": "\\\\$",
         "end": "^",
         "beginCaptures": {
          "0": {
           "name": "def.preprocessor"
          }
         },
         "endCaptures": {
          "0": {
           "name": "def.preprocessor"
          }
         }
        },
        {
         "patterns": [
          {
           "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
           "name": "def.underlined"
          },
          {
           "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
           "name": "def.underlined"
          },
          {
           "match": "\\b(FIXME|TODO|XXX)\\b",
           "name": "def.note"
          }
         ]
        }
       ]
      }
     ]
    }
   ]
  }
 ],
 "fileTypes": [
  "abnf"
 ]
}