{
 "name": "D",
 "scopeName": "source.d",
 "patterns": [
  {
   "begin": "^#!",
   "end": "$",
   "name": "def.comment"
  },
  {
   "begin": "//",
   "end": "$",
   "name": "def.comment",
   "patterns": [
    {
     "patterns": [
      {
       "begin": "\\\\$",
       "end": "^",
       "name": "def.preprocessor"
      },
      {
       "patterns": [
        {
         "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
         "name": "def.underlined"
        },
        {
         "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
         "name": "def.underlined"
        },
        {
         "match": "\\b(FIXME|TODO|XXX)\\b",
         "name": "def.note"
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "begin": "/\\*",
   "end": "\\*/",
   "name": "def.comment",
   "patterns": [
    {
     "patterns": [
      {
       "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
       "name": "def.underlined"
      },
      {
       "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
       "name": "def.underlined"
      },
      {
       "match": "\\b(FIXME|TODO|XXX)\\b",
       "name": "def.note"
      }
     ]
    }
   ]
  },
  {
   "match": "\\*/(?!\\*)",
   "name": "def.error"
  },
  {
   "begin": "/\\+",
   "end": "\\+/",
   "name": "def.comment",
   "patterns": [
    {
     "patterns": [
      {
       "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
       "name": "def.underlined"
      },
      {
       "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
       "name": "def.underlined"
      },
      {
       "match": "\\b(FIXME|TODO|XXX)\\b",
       "name": "def.note"
      }
     ]
    }
   ]
  },
  {
   "begin": "\"",
   "end": "\"",
   "name": "def.string",
   "patterns": [
    {
     "match": "\\\\.",
     "name": "def.special-char"
    },
    {
     "begin": "\\\\$",
     "end": "^",
     "name": "def.preprocessor"
    }
   ]
  },
  {
   "begin": "'",
   "end": "(?:')|$",
   "name": "def.string",
   "patterns": [
    {
     "match": "\\\\.",
     "name": "def.special-char"
    },
    {
     "begin": "\\\\$",
     "end": "^",
     "name": "def.preprocessor"
    }
   ]
  },
  {
   "begin": "`",
   "end": "`",
   "name": "def.string",
   "patterns": [
    {
     "match": "\\\\.",
     "name": "def.special-char"
    },
    {
     "begin": "\\\\$",
     "end": "^",
     "name": "def.preprocessor"
    }
   ]
  },
  {
   "match": "\\b(?:abstract|align|asm|assert|body|break|case|cast|catch|continue|debug|default|delegate|delete|deprecated|do|else|final|finally|for|foreach|function|goto|if|import|in|inout|is|mixin|new|out|override|pragma|private|protected|public|ref|return|scope|super|switch|synchronized|this|throw|try|typeid|typeof|unittest|version|while|with|lazy|pure|nothrow)\\b",
   "name": "def.keyword"
  },
  {
   "match": "\\b(?:alias|bool|byte|cdouble|cent|cfloat|char|class|creal|dchar|double|enum|export|float|idouble|ifloat|int|interface|invariant|ireal|long|module|package|ptrdiff_t|real|short|size_t|struct|template|typedef|ubyte|ucent|uint|ulong|union|ushort|void|wchar|auto|const|extern|static|volatile|__gshared|__traits|__vector|__parameters|shared|string|dstring|wstring|immutable)\\b",
   "name": "def.type"
  },
  {
   "match": "\\b(?:\\#line|__DATE__|__FILE__|__FUNCTION__|__LINE__|__MODULE__|__PRETTY_FUNCTION__|__TIME__|__TIMESTAMP__|__VENDOR__|__VERSION__)\\b",
   "name": "def.preprocessor"
  },
  {
   "match": "\\b(?:null)\\b",
   "name": "def.special-constant"
  },
  {
   "match": "\\b(?:false|true)\\b",
   "name": "def.boolean"
  },
  {
   "match": "(?<![[A-Za-z0-9_\\x80-\\xFF]\\.])([0-9_]+[Ee][-]?[0-9_]+|([0-9_]*\\.[0-9_]+|[0-9_]+\\.)([Ee][-]?[0-9_]+)?)[fFLi]?(?![[A-Za-z0-9_\\x80-\\xFF]\\.])",
   "name": "def.floating-point"
  },
  {
   "match": "(?<![[A-Za-z0-9_\\x80-\\xFF]\\.])0[bB][01_]*(?![[A-Za-z0-9_\\x80-\\xFF]\\.])",
   "name": "def.base-n-integer"
  },
  {
   "match": "(?<![[A-Za-z0-9_\\x80-\\xFF]\\.])0[0-7_]+([Uu]([Ll]|LL|ll)?|([Ll]|LL|ll)[Uu]?)?(?![[A-Za-z0-9_\\x80-\\xFF]\\.])",
   "name": "def.base-n-integer"
  },
  {
   "match": "(?<![[A-Za-z0-9_\\x80-\\xFF]\\.])([1-9][0-9_]*|0)([Uu]([Ll]|LL|ll)?|([Ll]|LL|ll)[Uu]?)?(?![[A-Za-z0-9_\\x80-\\xFF]\\.])",
   "name": "def.decimal"
  },
  {
   "match": "(?<![[A-Za-z0-9_\\x80-\\xFF]\\.])0[xX][0-9a-fA-F_]+([Uu]([Ll]|LL|ll)?|([Ll]|LL|ll)[Uu]?)?(?![[A-Za-z0-9_\\x80-\\xFF]\\.])",
   "name": "def.base-n-integer"
  }
 ],
 "foldingStartMarker": "\\{[^}\"\\x27]*$",
 "foldingStopMarker": "^[^{\"\\x27]*\\}",
 "fileTypes": [
  "d"
 ]
}