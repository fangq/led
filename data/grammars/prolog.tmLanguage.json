{
 "name": "Prolog",
 "scopeName": "source.prolog",
 "patterns": [
  {
   "match": "\\b(?:module|meta_predicate|multifile|dynamic|abolish|current_output|peek_code|append|current_predicate|put_byte|arg|current_prolog_flag|put_char|asserta|assert|fail|put_code|assertz|findall|read|at_end_of_stream|float|read_term|atom|flush_output|repeat|atom_chars|functor|retract|atom_codes|get_byte|set_input|atom_concat|get_char|set_output|atom_length|get_code|set_prolog_flag|atomic|halt|set_stream_position|bagof|integer|setof|call|is|stream_property|catch|nl|sub_atom|char_code|nonvar|throw|char_conversion|number|clause|number_chars|unify_with_occurs_check|close|number_codes|var|compound|once|copy_term|op|write|writeln|write_canonical|write_term|writeq|current_char_conversion|open|current_input|peek_byte|current_op|peek_char|false|true|consult|member|memberchk|reverse|permutation|delete)\\b",
   "name": "def.keyword"
  },
  {
   "match": "\\b(?:mod|div|abs|exp|ln|log|sqrt|round|trunc|val|cos|sin|tan|arctan|random|randominit)\\b",
   "name": "def.keyword"
  },
  {
   "match": "\\b[0-9]+(\\.[0-9]+)?\\b",
   "name": "def.decimal"
  },
  {
   "begin": "\"",
   "end": "(?:\")|$",
   "name": "def.string",
   "patterns": [
    {
     "match": "(?:\\\\([\\\\\\\"\\'nrbtfav\\?]|[0-7]{1,3}|x[0-9A-Fa-f]+))",
     "name": "def.special-char"
    }
   ]
  },
  {
   "begin": "'",
   "end": "(?:')|$",
   "name": "def.string",
   "patterns": [
    {
     "match": "(?:\\\\([\\\\\\\"\\'nrbtfav\\?]|[0-7]{1,3}|x[0-9A-Fa-f]+))",
     "name": "def.special-char"
    }
   ]
  },
  {
   "match": "([!;]|:\\-)",
   "name": "def.operator"
  },
  {
   "match": "(?<!(?:[-!+\\\\|=:&><]))(?:=|==|=\\\\\\\\=|=:=|\\\\\\||<|>|=<|>=|\\\\\\\\=|\\\\\\\\==|\\\\\\\\\\\\\\+)(?!(?:[-!+\\\\|=:&><]))",
   "name": "def.operator"
  },
  {
   "match": "\\b(_|[A-Z][A-Za-z0-9_]*)\\b",
   "name": "def.type"
  },
  {
   "begin": "/\\*",
   "end": "\\*/",
   "name": "def.comment",
   "patterns": [
    {
     "patterns": [
      {
       "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
       "name": "def.underlined"
      },
      {
       "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
       "name": "def.underlined"
      },
      {
       "match": "\\b(FIXME|TODO|XXX)\\b",
       "name": "def.note"
      }
     ]
    }
   ]
  },
  {
   "begin": "%",
   "end": "$",
   "name": "def.comment",
   "patterns": [
    {
     "patterns": [
      {
       "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
       "name": "def.underlined"
      },
      {
       "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
       "name": "def.underlined"
      },
      {
       "match": "\\b(FIXME|TODO|XXX)\\b",
       "name": "def.note"
      }
     ]
    }
   ]
  },
  {
   "match": "\\*/(?!\\*)",
   "name": "def.error"
  }
 ],
 "fileTypes": [
  "prolog"
 ]
}