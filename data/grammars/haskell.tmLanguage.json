{
 "name": "Haskell",
 "scopeName": "source.haskell",
 "patterns": [
  {
   "begin": "^#!",
   "end": "$",
   "name": "def.comment"
  },
  {
   "begin": "(?:^\\s*#\\s*)if\\b\\s*0\\b",
   "end": "(?:^\\s*#\\s*)(endif|else|elif)\\b",
   "name": "def.comment",
   "patterns": [
    {
     "begin": "(?:^\\s*#\\s*)if(n?def)?\\b",
     "end": "(?:^\\s*#\\s*)endif\\b",
     "patterns": [
      {
       "begin": "(?:^\\s*#\\s*)if(n?def)?\\b",
       "end": "(?:^\\s*#\\s*)endif\\b",
       "patterns": [
        {
         "patterns": [
          {
           "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
           "name": "def.underlined"
          },
          {
           "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
           "name": "def.underlined"
          },
          {
           "match": "\\b(FIXME|TODO|XXX)\\b",
           "name": "def.note"
          }
         ]
        }
       ]
      },
      {
       "patterns": [
        {
         "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
         "name": "def.underlined"
        },
        {
         "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
         "name": "def.underlined"
        },
        {
         "match": "\\b(FIXME|TODO|XXX)\\b",
         "name": "def.note"
        }
       ]
      }
     ]
    },
    {
     "patterns": [
      {
       "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
       "name": "def.underlined"
      },
      {
       "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
       "name": "def.underlined"
      },
      {
       "match": "\\b(FIXME|TODO|XXX)\\b",
       "name": "def.note"
      }
     ]
    }
   ]
  },
  {
   "match": "(?:^\\s*#\\s*)(include|import)\\s*(\".*?\"|<.*>)",
   "name": "def.preprocessor",
   "captures": {
    "2": {
     "name": "def.string"
    }
   }
  },
  {
   "begin": "(?:^\\s*#\\s*)(define|undef|error|pragma|ident|if(n?def)?|else|elif|endif|line|warning)\\b",
   "end": "$",
   "name": "def.preprocessor",
   "patterns": [
    {
     "begin": "\\\\$",
     "end": "^",
     "name": "def.preprocessor"
    },
    {
     "begin": "L?\"",
     "end": "(?:\")|$",
     "name": "def.string",
     "patterns": [
      {
       "match": "\\%\\%|\\%(?:[1-9][0-9]*\\$)?[#0\\-\\ \\+\\'I]*(?:[1-9][0-9]*|\\*)?(?:\\.\\-?(?:[0-9]+|\\*))?(?:hh|ll|[hlLqjzt])?[diouxXeEfFgGaAcsCSpnm]",
       "name": "def.special-char"
      },
      {
       "match": "(?:\\\\([\\\\\\\"\\'nrbtfav\\?]|[0-7]{1,3}|x[0-9A-Fa-f]+))",
       "name": "def.special-char"
      },
      {
       "begin": "\\\\$",
       "end": "^",
       "name": "def.preprocessor"
      }
     ]
    },
    {
     "begin": "//",
     "end": "$",
     "name": "def.comment",
     "patterns": [
      {
       "patterns": [
        {
         "begin": "\\\\$",
         "end": "^",
         "name": "def.preprocessor"
        },
        {
         "patterns": [
          {
           "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
           "name": "def.underlined"
          },
          {
           "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
           "name": "def.underlined"
          },
          {
           "match": "\\b(FIXME|TODO|XXX)\\b",
           "name": "def.note"
          }
         ]
        }
       ]
      }
     ]
    },
    {
     "begin": "/\\*",
     "end": "\\*/",
     "name": "def.comment",
     "patterns": [
      {
       "patterns": [
        {
         "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
         "name": "def.underlined"
        },
        {
         "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
         "name": "def.underlined"
        },
        {
         "match": "\\b(FIXME|TODO|XXX)\\b",
         "name": "def.note"
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "patterns": [
    {
     "begin": "(?<!(?:[!#$%&*./>=<?@:\\\\^|~-]))--+(?!(?:[!#$%&*./>=<?@:\\\\^|~-]))",
     "end": "$",
     "name": "def.comment",
     "patterns": [
      {
       "patterns": [
        {
         "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
         "name": "def.underlined"
        },
        {
         "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
         "name": "def.underlined"
        },
        {
         "match": "\\b(FIXME|TODO|XXX)\\b",
         "name": "def.note"
        }
       ]
      },
      {
       "begin": "\\s+([|^*$]+)",
       "end": "^(?!\\s*--+)",
       "name": "def.doc-comment",
       "patterns": [
        {
         "match": "\\\\[/'`\"@#<*-]",
         "name": "def.special-char"
        },
        {
         "match": "&#([0-9]+|x[a-fA-F0-9]+);",
         "name": "def.special-char"
        },
        {
         "match": "'[a-zA-Z_][0-9a-zA-Z._'#]*'",
         "name": "def.doc-comment-element"
        },
        {
         "match": "\"[A-Z][0-9a-zA-Z._']*\"",
         "name": "def.doc-comment-element"
        },
        {
         "begin": "/",
         "end": "/",
         "name": "def.doc-comment-element",
         "patterns": [
          {
           "match": "\\\\[/'`\"@#<*-]",
           "name": "def.special-char"
          },
          {
           "match": "&#([0-9]+|x[a-fA-F0-9]+);",
           "name": "def.special-char"
          }
         ]
        },
        {
         "begin": "@",
         "end": "@",
         "name": "haddock.monospace",
         "patterns": [
          {
           "match": "\\\\[/'`\"@#<*-]",
           "name": "def.special-char"
          },
          {
           "match": "&#([0-9]+|x[a-fA-F0-9]+);",
           "name": "def.special-char"
          }
         ]
        },
        {
         "match": "^\\s*--+\\s+>.*$",
         "name": "haddock.codeblock"
        },
        {
         "match": "^\\s*--+\\s+([A-Z][a-zA-Z0-9'_]*)\\s*:.*$",
         "captures": {
          "1": {
           "name": "def.doc-comment-element"
          }
         }
        },
        {
         "match": "^(\\s*--+)?\\s+(\\*(?=\\s)|-(?=\\s)|\\([0-9]\\)|[0-9]\\.|\\[@[a-zA-Z0-9._'\\#]*@\\])",
         "captures": {
          "2": {
           "name": "def.doc-comment-element"
          }
         }
        },
        {
         "match": "<.*>",
         "name": "def.underlined"
        },
        {
         "match": "#[a-z][0-9a-zA-Z_']*#|[A-Z][0-9a-zA-Z._']*#[a-z][0-9a-zA-Z_']*",
         "name": "def.doc-comment-element"
        }
       ]
      },
      {
       "match": "#(?:hide|prune|ignore\\-exports)\\b",
       "name": "def.doc-comment-element"
      }
     ]
    },
    {
     "begin": "\\{-#",
     "end": "#-\\}",
     "name": "def.preprocessor"
    },
    {
     "begin": "\\{-",
     "end": "-\\}",
     "name": "def.comment",
     "patterns": [
      {
       "patterns": [
        {
         "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
         "name": "def.underlined"
        },
