        {
         "match": "#[a-z][0-9a-zA-Z_']*#|[A-Z][0-9a-zA-Z._']*#[a-z][0-9a-zA-Z_']*",
         "name": "def.doc-comment-element"
        }
       ]
      },
      {
       "match": "#(?:hide|prune|ignore\\-exports)\\b",
       "name": "def.doc-comment-element"
      }
     ]
    },
    {
     "match": "\\b(?:case|class|data|default|deriving|do|mdo|else|forall|foreign|hiding|if|import|in|infix|infixl|infixr|instance|let|module|newtype|of|qualified|then|where|type)\\b",
     "name": "def.keyword"
