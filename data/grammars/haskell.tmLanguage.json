     "match": "(?<!(?:[!#$%&*./>=<?@:\\\\^|~-]))(?:\\\\\\.\\\\\\.|::|=|\\\\\\||\\\\|\\->|<\\-|@|\\~|=>)(?!(?:[!#$%&*./>=<?@:\\\\^|~-]))",
