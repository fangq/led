{
 "name": "Ada",
 "scopeName": "source.ada",
 "patterns": [
  {
   "begin": "--",
   "end": "$",
   "beginCaptures": {
    "0": {
     "name": "def.comment"
    }
   },
   "endCaptures": {
    "0": {
     "name": "def.comment"
    }
   },
   "patterns": [
    {
     "patterns": [
      {
       "begin": "\\\\$",
       "end": "^",
       "beginCaptures": {
        "0": {
         "name": "def.preprocessor"
        }
       },
       "endCaptures": {
        "0": {
         "name": "def.preprocessor"
        }
       }
      },
      {
       "patterns": [
        {
         "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
         "name": "def.underlined"
        },
        {
         "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
         "name": "def.underlined"
        },
        {
         "match": "\\b(FIXME|TODO|XXX)\\b",
         "name": "def.note"
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "begin": "\"",
   "end": "(?:\")|$",
   "beginCaptures": {
    "0": {
     "name": "def.string"
    }
   },
   "endCaptures": {
    "0": {
     "name": "def.string"
    }
   },
   "patterns": [
    {
     "match": "\"\"",
     "name": "def.special-char"
    }
   ]
  },
  {
   "match": "'.'",
   "name": "def.string"
  },
  {
   "match": "\\b(?:package|pragma|use|with)\\b",
   "name": "def.preprocessor"
  },
  {
   "match": "\\b(?:function|procedure|return)\\b",
   "name": "def.keyword"
  },
  {
   "match": "\\b(?:abort|abs|accept|all|and|begin|body|case|declare|delay|do|else|elsif|end|entry|exception|exit|for|generic|goto|if|in|is|loop|mod|new|not|null|or|others|out|protected|raise|record|rem|renames|requeue|reverse|select|separate|subtype|task|terminate|then|type|until|when|while|xor)\\b",
   "name": "def.keyword"
  },
  {
   "match": "\\b(?:abstract|access|aliased|array|at|constant|delta|digits|interface|limited|of|private|range|tagged|synchronized)\\b",
   "name": "def.type"
  },
  {
   "match": "\\b(?:boolean|character|count|duration|float|integer|long_float|long_integer|priority|short_float|short_integer|string)\\b",
   "name": "def.type"
  },
  {
   "match": "(?<![[A-Za-z0-9_\\x80-\\xFF]\\.])[0-9][0-9_]*\\#(?:[0-9a-f][0-9a-f_]*)(\\.(?:[0-9a-f][0-9a-f_]*))?\\#(?:[Ee][+-]?[0-9][0-9_]*)?(?![[A-Za-z0-9_\\x80-\\xFF]\\.])",
   "name": "def.base-n-integer"
  },
  {
   "match": "(?<![[A-Za-z0-9_\\x80-\\xFF]\\.])[0-9][0-9_]*\\.[0-9][0-9_]*(?:[Ee][+-]?[0-9][0-9_]*)?(?![[A-Za-z0-9_\\x80-\\xFF]\\.])",
   "name": "def.floating-point"
  },
  {
   "match": "(?<![[A-Za-z0-9_\\x80-\\xFF]\\.])[0-9][0-9_]*(E[+]?[0-9][0-9_]*)?(?![[A-Za-z0-9_\\x80-\\xFF]\\.])",
   "name": "def.decimal"
  },
  {
   "match": "\\b(?:true|false)\\b",
   "name": "def.boolean"
  }
 ],
 "fileTypes": [
  "adb",
  "ads"
 ]
}