{
 "name": "GAP",
 "scopeName": "source.gap",
 "patterns": [
  {
   "begin": "#",
   "end": "$",
   "name": "def.comment",
   "patterns": [
    {
     "patterns": [
      {
       "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
       "name": "def.underlined"
      },
      {
       "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
       "name": "def.underlined"
      },
      {
       "match": "\\b(FIXME|TODO|XXX)\\b",
       "name": "def.note"
      }
     ]
    }
   ]
  },
  {
   "begin": "\"",
   "end": "(?:\")|$",
   "name": "def.constant",
   "patterns": [
    {
     "match": "\\\\.",
     "name": "def.special-char"
    },
    {
     "begin": "\\\\$",
     "end": "^",
     "name": "def.preprocessor"
    }
   ]
  },
  {
   "match": "\\'(\\\\[trnb\\\\\\'\\\"]|[^\\\\])\\'",
   "name": "def.string"
  },
  {
   "match": "\\b(?:and|break|continue|do|elif|else|end|fail|false|fi|for|function|if|in|infinity|local|not|od|or|rec|repeat|return|then|true|until|while)\\b",
   "name": "def.keyword"
  },
  {
   "match": "\\b[0-9]+\\b",
   "name": "def.decimal"
  }
 ],
 "foldingStartMarker": "\\{[^}\"\\x27]*$",
 "foldingStopMarker": "^[^{\"\\x27]*\\}",
 "fileTypes": [
  "g",
  "gd",
  "gi",
  "gap"
 ]
}