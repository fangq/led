    "0": {
     "name": "def.comment"
    }
   },
   "endCaptures": {
    "0": {
     "name": "def.comment"
    }
   },
   "patterns": [
    {
     "patterns": [
      {
       "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
       "name": "def.underlined"
      },
      {
       "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
       "name": "def.underlined"
      },
      {
       "match": "\\b(FIXME|TODO|XXX)\\b",
       "name": "def.note"
      }
     ]
    }
   ]
  },
  {
   "begin": "^@ignore\\s*$",
   "end": "^@end ignore\\s*$",
   "beginCaptures": {
    "0": {
     "name": "def.comment"
    }
   },
   "endCaptures": {
    "0": {
     "name": "def.comment"
    }
   },
   "patterns": [
    {
     "patterns": [
      {
       "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
       "name": "def.underlined"
      },
      {
       "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
       "name": "def.underlined"
      },
      {
       "match": "\\b(FIXME|TODO|XXX)\\b",
       "name": "def.note"
      }
     ]
    }
   ]
  },
  {
   "match": "@(@|{|})",
   "name": "def.special-char"
  },
  {
   "begin": "\\{[^}]",
   "end": "\\}",
   "beginCaptures": {
    "0": {
     "name": "def.string"
    }
   },
   "endCaptures": {
    "0": {
     "name": "def.string"
    }
   }
  },
  {
   "patterns": [
    {
     "match": "^@(?:alias|clear|defcodeindex|defindex|definfoenclose|ifclear|ifset|macro|set|syncodeindex|synindex)\\b",
     "name": "def.keyword"
    },
    {
     "match": "^@(?:bye|\\(end\\ \\)\\?docbook|\\(end\\ \\)\\?html|end\\ ifclear|\\(end\\ \\)\\?if\\(not\\)\\?docbook|\\(end\\ \\)\\?if\\(not\\)\\?html|\\(end\\ \\)\\?if\\(not\\)\\?info|\\(end\\ \\)\\?if\\(not\\)\\?plaintext|\\(end\\ \\)\\?if\\(not\\)\\?tex|\\(end\\ \\)\\?if\\(not\\)\\?xml|end\\ ifset|lowersections|end\\ macro|raisesections|\\(end\\ \\)\\?tex|\\(end\\ \\)\\?xml)\\s*$",
     "name": "def.keyword"
    }
   ]
  },
  {
   "match": "^@(?:cindex|findex|kindex|pindex|tindex|vindex)\\b",
   "name": "def.keyword"
  },
  {
   "patterns": [
    {
     "match": "^@(?:dircategory|documentencoding|documentlanguage|evenfooting|evenheading|everyfooting|everyheading|footnotestyle|headings|kbdinputstyle|oddfooting|oddheading|pagesizes|paragraphindent|setchapternewpage|setfilename|settitle|titlefont)\\b",
     "name": "def.keyword"
    },
    {
     "match": "^@(?:afivepaper|afourlatex|afourpaper|afourwide|\\(end\\ \\)\\?direntry|\\(end\\ \\)\\?documentdescription|finalout|novalidate|setcontentsaftertitlepage|setshortcontentsaftertitlepage|smallbook)\\s*$",
     "name": "def.keyword"
    }
   ]
  },
  {
   "match": "None(?:\\^@contents\\\\s\\*\\$|\\^@insertcopying\\\\s\\*\\$|\\^@listoffloats\\\\s\\*\\$|\\^@printindex\\\\s\\*\\$|\\^@shortcontents\\\\s\\*\\$|\\^@shorttitlepage\\\\s\\*\\$|\\^@summarycontents\\\\s\\*\\$|@thischapter\\\\b|@thischaptername\\\\b|@thisfile\\\\b|@thispage\\\\b|@thistitle\\\\b|@today\\\\b|@value\\\\b|@verb\\\\b|\\^@\\(end\\ \\)\\?verbatim\\\\s\\*\\$|\\^@verbatiminclude\\\\b)None",
   "name": "def.keyword"
  },
  {
   "match": "None(?:\\^\\\\\\\\input|\\^@include|@image)\\b",
   "name": "def.preprocessor"
  },
  {
   "match": "@(?:acronym|anchor|caption|cite|code|command|dfn|dmn|email|emph|env|file|footnote|indicateurl|inforef|kbd|key|math|option|pxref|ref|samp|strong|uref|url|var|xref)\\b",
   "name": "def.keyword"
  },
  {
