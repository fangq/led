{
 "name": ".ini",
 "scopeName": "source.ini",
 "patterns": [
  {
   "begin": ";|#",
   "end": "$",
   "beginCaptures": {
    "0": {
     "name": "def.comment"
    }
   },
   "endCaptures": {
    "0": {
     "name": "def.comment"
    }
   }
  },
  {
   "begin": "^\\[",
   "end": "\\]$",
   "beginCaptures": {
    "0": {
     "name": "def.keyword"
    }
   },
   "endCaptures": {
    "0": {
     "name": "def.keyword"
    }
   }
  },
  {
   "match": "^_?X\\-[a-zA-Z\\-]+",
   "name": "def.type"
  },
  {
   "match": "\\[[a-zA-Z_]+\\]",
   "name": "def.decimal"
  },
  {
   "match": "^[a-zA-Z_][a-zA-Z0-9_.-]*",
   "name": "def.type"
  },
  {
   "match": "\\b(?:true|false|on|off|yes|no)\\b",
   "name": "def.boolean"
  },
  {
   "begin": "'",
   "end": "'",
   "beginCaptures": {
    "0": {
     "name": "def.string"
    }
   },
   "endCaptures": {
    "0": {
     "name": "def.string"
    }
   }
  },
  {
   "begin": "\"",
   "end": "\"",
   "beginCaptures": {
    "0": {
     "name": "def.string"
    }
   },
   "endCaptures": {
    "0": {
     "name": "def.string"
    }
   }
  },
  {
   "match": "(\\b[0-9]+(\\.[0-9]+)?|\\.[0-9]+)([Ee][\\+-]?[0-9]+)?\\b",
   "name": "def.floating-point"
  },
  {
   "match": "\\b[0-9]+\\b",
   "name": "def.decimal"
  }
 ],
 "fileTypes": [
  "ini"
 ]
}