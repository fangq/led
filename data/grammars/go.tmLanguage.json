{
 "name": "Go",
 "scopeName": "source.go",
 "patterns": [
  {
   "begin": "//",
   "end": "$",
   "name": "def.comment",
   "patterns": [
    {
     "patterns": [
      {
       "begin": "\\\\$",
       "end": "^",
       "name": "def.preprocessor"
      },
      {
       "patterns": [
        {
         "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
         "name": "def.underlined"
        },
        {
         "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
         "name": "def.underlined"
        },
        {
         "match": "\\b(FIXME|TODO|XXX)\\b",
         "name": "def.note"
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "begin": "/\\*",
   "end": "\\*/",
   "name": "def.comment",
   "patterns": [
    {
     "patterns": [
      {
       "match": "(?:\\b                                         # separator\n      (https?|ftp|nntp|news|javascript|about):    # protocol\n      [^\\ \\\\]*[^\\ \\\\.:;,?><)](?![a-z0-9_.-]))",
       "name": "def.underlined"
      },
      {
       "match": "(?:\\b                 # separator\n      (mailto:)?          # optional \"mailto:\"\n      [a-z0-9_.+-]+@[a-z0-9_.+-]+\\b)",
       "name": "def.underlined"
      },
      {
       "match": "\\b(FIXME|TODO|XXX)\\b",
       "name": "def.note"
      }
     ]
    }
   ]
  },
  {
   "match": "\\*/(?!\\*)",
   "name": "def.error"
  },
  {
   "begin": "\"",
   "end": "(?:\")|$",
   "name": "def.string",
   "patterns": [
    {
     "match": "\\%\\%|\\b#0\\-\\ \\+\\*]*(?:[1-9][0-9]*|\\*)?(?:\\.(?:[0-9]+|\\*))?[vTtbcdoqxXUeEfgGsp]",
     "name": "def.special-char"
    },
    {
     "match": "(?:\\\\([\\\\\\\"\\'nrbtfav\\?]|[0-7]{1,3}|x[0-9A-Fa-f]+))",
     "name": "def.special-char"
    },
    {
     "begin": "\\\\$",
     "end": "^",
     "name": "def.preprocessor"
    }
   ]
  },
  {
   "begin": "`",
   "end": "`",
   "name": "def.string",
   "patterns": [
    {
     "match": "\\%\\%|\\b#0\\-\\ \\+\\*]*(?:[1-9][0-9]*|\\*)?(?:\\.(?:[0-9]+|\\*))?[vTtbcdoqxXUeEfgGsp]",
     "name": "def.special-char"
    },
    {
     "begin": "\\\\$",
     "end": "^",
     "name": "def.preprocessor"
    }
   ]
  },
  {
   "match": "'((?:\\\\([\\\\\\\"\\'nrbtfav\\?]|[0-7]{1,3}|x[0-9A-Fa-f]+))|.)'",
   "name": "def.character"
  },
  {
   "match": "(?<![[A-Za-z0-9_\\x80-\\xFF]\\.])(?:((\\.[0-9]+|[0-9]+\\.[0-9]*)([Ee][+-]?[0-9]+)?|([0-9]+[Ee][+-]?[0-9]+)))(?![[A-Za-z0-9_\\x80-\\xFF]\\.])",
   "name": "def.floating-point"
  },
  {
   "match": "(?<![[A-Za-z0-9_\\x80-\\xFF]\\.])0[xX][a-fA-F0-9]+(?![[A-Za-z0-9_\\x80-\\xFF]\\.])",
   "name": "def.base-n-integer"
  },
  {
   "match": "(?<![[A-Za-z0-9_\\x80-\\xFF]\\.])0[xX][a-fA-F0-9]*[g-zG-Z][a-zA-Z0-9]*(?![[A-Za-z0-9_\\x80-\\xFF]\\.])",
   "name": "def.error"
  },
  {
   "match": "(?<![[A-Za-z0-9_\\x80-\\xFF]\\.])0[0-7]+(?![[A-Za-z0-9_\\x80-\\xFF]\\.])",
   "name": "def.base-n-integer"
  },
  {
   "match": "(?<![[A-Za-z0-9_\\x80-\\xFF]\\.])0[0-7]*[89][0-9]*(?![[A-Za-z0-9_\\x80-\\xFF]\\.])",
   "name": "def.error"
  },
  {
   "match": "(?<![[A-Za-z0-9_\\x80-\\xFF]\\.])(0|[1-9][0-9]*)(?![[A-Za-z0-9_\\x80-\\xFF]\\.])",
   "name": "def.decimal"
  },
  {
   "match": "(?<![[A-Za-z0-9_\\x80-\\xFF]\\.])(true|false)(?![[A-Za-z0-9_\\x80-\\xFF]\\.])",
   "name": "def.boolean"
  },
  {
   "match": "\\b(?:break|case|const|continue|default|defer|else|fallthrough|for|func|go|goto|if|import|interface|package|range|return|select|struct|switch|type|var)\\b",
   "name": "def.keyword"
  },
  {
   "match": "\\b(?:bool|byte|chan|complex64|complex128|error|float32|float64|func|int|int8|int16|int32|int64|map|rune|string|uint|uint8|uint16|uint32|uint64|uintptr)\\b",
   "name": "def.type"
  },
  {
   "match": "\\b(?:iota|nil)\\b",
   "name": "def.special-constant"
  },
  {
   "match": "\\b(?:append|cap|close|complex|copy|delete|imag|len|make|new|panic|real|recover)\\b",
   "name": "def.builtin"
  }
 ],
 "foldingStartMarker": "\\{[^}\"\\x27]*$",
 "foldingStopMarker": "^[^{\"\\x27]*\\}",
 "fileTypes": [
  "go"
 ]
}