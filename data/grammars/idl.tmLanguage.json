{
 "name": "IDL",
 "scopeName": "source.idl",
 "patterns": [
  {
   "begin": "/\\*",
   "end": "\\*/",
   "name": "def.comment",
   "patterns": [
    {
     "match": "\\\\.",
     "name": "def.special-char"
    },
    {
     "begin": "\\\\$",
     "end": "^",
     "name": "def.preprocessor"
    }
   ]
  },
  {
   "begin": "//",
   "end": "$",
   "name": "def.comment",
   "patterns": [
    {
     "match": "\\\\.",
     "name": "def.special-char"
    },
    {
     "begin": "\\\\$",
     "end": "^",
     "name": "def.preprocessor"
    }
   ]
  },
  {
   "begin": "%\\{",
   "end": "%\\}",
   "name": "def.preprocessor",
   "patterns": [
    {
     "match": "\\\\.",
     "name": "def.special-char"
    },
    {
     "begin": "\\\\$",
     "end": "^",
     "name": "def.preprocessor"
    }
   ]
  },
  {
   "begin": "\"",
   "end": "(?:\")|$",
   "name": "def.string",
   "patterns": [
    {
     "match": "\\\\.",
     "name": "def.special-char"
    },
    {
     "begin": "\\\\$",
     "end": "^",
     "name": "def.preprocessor"
    }
   ]
  },
  {
   "begin": "^#[ \\t]*(include|pragma)",
   "end": "$",
   "name": "def.preprocessor",
   "patterns": [
    {
     "match": "\\\\.",
     "name": "def.special-char"
    },
    {
     "begin": "\\\\$",
     "end": "^",
     "name": "def.preprocessor"
    }
   ]
  },
  {
   "match": "\\b(?:abstract|attribute|case|const|context|custom|default|exception|enum|factory|FALSE|in|inout|interface|local|module|native|oneway|out|private|public|raises|readonly|struct|support|switch|TRUE|truncatable|typedef|union|valuetype)\\b",
   "name": "def.keyword"
  },
  {
   "match": "\\b(?:any|boolean|char|double|fixed|float|long|Object|octet|sequence|short|string|unsigned|ValueBase|void|wchar|wstring)\\b",
   "name": "def.type"
  },
  {
   "match": "^[ \\t]*#[ \\t]*(?:if|ifdef|ifndef|else|elif|define|endif|undef)\\b",
   "name": "def.preprocessor"
  }
 ],
 "foldingStartMarker": "\\{[^}\"\\x27]*$",
 "foldingStopMarker": "^[^{\"\\x27]*\\}",
 "fileTypes": [
  "idl"
 ]
}