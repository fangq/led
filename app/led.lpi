<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False"/>
        <CompatibilityMode Value="True"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="led"/>
      <UseAppBundle Value="True"/>
      <ResourceType Value="res"/>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="SynEdit"/>
      </Item>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="led.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="../packages/ledui/src/led.ui.main.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="LedMainForm"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Form"/>
        <UnitName Value="Led.UI.Main"/>
      </Unit>
      <Unit>
        <Filename Value="../packages/ledui/src/led.ui.bench.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Led.UI.Bench"/>
      </Unit>
      <Unit>
        <Filename Value="../packages/ledui/src/led.ui.selftest.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Led.UI.SelfTest"/>
      </Unit>
      <Unit>
        <Filename Value="../packages/ledui/src/led.ui.dock.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Led.UI.Dock"/>
      </Unit>
      <Unit>
        <Filename Value="../packages/ledui/src/led.ui.document.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Led.UI.Document"/>
      </Unit>
      <Unit>
        <Filename Value="../packages/ledui/src/led.ui.tab.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Led.UI.Tab"/>
      </Unit>
      <Unit>
        <Filename Value="../packages/ledui/src/led.ui.edit.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Led.UI.Edit"/>
      </Unit>
      <Unit>
        <Filename Value="../packages/ledcore/src/led.core.types.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Led.Core.Types"/>
      </Unit>
      <Unit>
        <Filename Value="../packages/ledcore/src/led.core.encodings.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Led.Core.Encodings"/>
      </Unit>
      <Unit>
        <Filename Value="../packages/ledcore/src/led.core.fileio.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Led.Core.FileIO"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="../bin/led"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <OtherUnitFiles Value="../packages/ledcore/src;../packages/ledui/src;../packages/ledsyn/src"/>
      <UnitOutputDirectory Value="../lib/$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Parsing>
      <SyntaxOptions>
        <IncludeAssertionCode Value="True"/>
      </SyntaxOptions>
    </Parsing>
    <Linking>
      <Debugging>
        <DebugInfoType Value="dsDwarf3"/>
        <UseHeaptrc Value="True"/>
      </Debugging>
      <Options>
        <Win32>
          <GraphicApplication Value="True"/>
        </Win32>
      </Options>
    </Linking>
  </CompilerOptions>
</CONFIG>
