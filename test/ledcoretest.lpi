<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False"/>
        <MainUnitHasTitleStatement Value="False"/>
        <CompatibilityMode Value="True"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="ledcoretest"/>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="FPCUnitConsoleRunner"/>
      </Item>
      <Item>
        <PackageName Value="LazUtils"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="ledcoretest.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="src/led.term.tests.screen.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Led.Term.Tests.Screen"/>
      </Unit>
      <Unit>
        <Filename Value="src/led.core.tests.grep.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Led.Core.Tests.Grep"/>
      </Unit>
      <Unit>
        <Filename Value="src/led.core.tests.tools.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Led.Core.Tests.Tools"/>
      </Unit>
      <Unit>
        <Filename Value="src/led.core.tests.cli.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Led.Core.Tests.CLI"/>
      </Unit>
      <Unit>
        <Filename Value="src/led.syn.tests.theme.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Led.Syn.Tests.Theme"/>
      </Unit>
      <Unit>
        <Filename Value="src/led.syn.tests.languages.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Led.Syn.Tests.Languages"/>
      </Unit>
      <Unit>
        <Filename Value="src/led.core.tests.filters.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Led.Core.Tests.Filters"/>
      </Unit>
      <Unit>
        <Filename Value="src/led.core.tests.settings.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Led.Core.Tests.Settings"/>
      </Unit>
      <Unit>
        <Filename Value="src/led.core.tests.config.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Led.Core.Tests.Config"/>
      </Unit>
      <Unit>
        <Filename Value="src/led.core.tests.encodings.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Led.Core.Tests.Encodings"/>
      </Unit>
      <Unit>
        <Filename Value="src/led.core.tests.fileio.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Led.Core.Tests.FileIO"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="../bin/ledcoretest"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <OtherUnitFiles Value="src;../packages/ledcore/src;../packages/ledsyn/src;../packages/ledterm/src"/>
      <UnitOutputDirectory Value="../lib/test-$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Linking>
      <Debugging>
        <DebugInfoType Value="dsDwarf3"/>
      </Debugging>
    </Linking>
  </CompilerOptions>
</CONFIG>
